{
  "manifest_version": 3,
  "name": "Maps Lead Scraper",
  "version": "1.0.0",
  "description": "Scrape Google Maps business results and export leads",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/map-icon.png",
      "48": "icons/map-icon.png",
      "128": "icons/map-icon.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/map-icon.png",
    "48": "icons/map-icon.png",
    "128": "icons/map-icon.png"
  }
}
